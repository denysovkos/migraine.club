// Copies what next/font/google produced in the Next build into the SPA, so
// the fonts render byte for byte the same: the woff2 files (same URLs), the
// @font-face and fallback rules, and the hashed className / variable
// classes the components put in the DOM.
// Run after `npm run build`: npx tsx scripts/gen-spa-fonts.mts
import { copyFileSync, mkdirSync, readdirSync, readFileSync, writeFileSync } from 'node:fs';
import path from 'node:path';

const chunks = '.next/static/chunks';
const media = '.next/static/media';
const out = 'web/src/shims/media';

const fonts: Record<string, { className: string; variable: string; fontFamily: string }> = {};
let css = '';
for (const file of readdirSync(chunks).filter(f => f.endsWith('.css')).sort()) {
  const text = readFileSync(path.join(chunks, file), 'utf8');
  if (!text.includes('@font-face')) {
    continue;
  }
  const rules = text.match(/@font-face\{[^}]*\}|\.[\w-]+_(?:className|variable)\{[^}]*\}/g) ?? [];
  for (const rule of rules) {
    css += `${rule.replace(/url\(\.\.\/media\//g, 'url(./media/')}\n`;
    const cls = /^\.([\w-]+)_className\{font-family:([^;]+);/.exec(rule);
    if (cls) {
      const family = cls[2]!.split(',')[0]!.trim();
      fonts[family] = { ...fonts[family]!, className: `${cls[1]}_className`, fontFamily: cls[2]!.split(',').map(f => `'${f.trim()}'`).join(', ') };
    }
    const v = /^\.([\w-]+)_variable\{--[\w-]+:"([^"]+)"/.exec(rule);
    if (v) {
      fonts[v[2]!] = { ...fonts[v[2]!]!, variable: `${v[1]}_variable` };
    }
  }
}
mkdirSync(out, { recursive: true });
for (const f of readdirSync(media)) {
  copyFileSync(path.join(media, f), path.join(out, f));
}
writeFileSync('web/src/shims/fonts.generated.css', css);
writeFileSync('web/src/shims/fonts.generated.ts', `// Generated by scripts/gen-spa-fonts.mts from the Next build. Do not edit.\nexport const FONTS = ${JSON.stringify(fonts, null, 2)} as const;\n`);
console.log(Object.keys(fonts));
