const cases = inputs.map((input) => {
  try {
    JSON.parse(input);
    return { input, message: '' };
  } catch (error) {
    return { input, message: (error as Error).message };
  }
});
mkdirSync('internal/httpx/testdata', { recursive: true });
writeFileSync('internal/httpx/testdata/json_syntax.json', `${JSON.stringify(cases, null, 1)}\n`);
console.log(cases.length, 'cases');
