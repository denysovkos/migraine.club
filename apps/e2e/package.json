{
  "name": "@migraine/e2e",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "test:e2e": "cross-env E2E_MOCK_AUTH=true NEXT_PUBLIC_E2E_MOCK_AUTH=true playwright test",
    "lint": "eslint .",
    "check-types": "tsc --noEmit --pretty",
    "test": "vitest run",
    "e2e:seed": "dotenv -e ../../.env -- tsx seeds/e2e-seed.ts",
    "e2e:seed:onboarding": "dotenv -e ../../.env -- tsx seeds/e2e-seed-onboarding.ts",
    "e2e:seed:attack-mode": "dotenv -e ../../.env -- tsx seeds/e2e-seed-attack-mode.ts",
    "e2e:seed:pain-timeline": "dotenv -e ../../.env -- tsx seeds/e2e-seed-pain-timeline.ts",
    "e2e:seed:relief": "dotenv -e ../../.env -- tsx seeds/e2e-seed-relief.ts",
    "e2e:reset": "dotenv -e ../../.env -- tsx seeds/e2e-reset.ts"
  },
  "devDependencies": {
    "@migraine/client": "*",
    "@migraine/db": "*",
    "@migraine/server": "*",
    "@playwright/test": "^1.65.1",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.1.0",
    "drizzle-orm": "^0.45.4",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0"
  }
}
