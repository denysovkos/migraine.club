{
  "name": "migraine-club",
  "version": "1.7.6",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build-stats": "cross-env ANALYZE=true npm run build",
    "clean": "rimraf .next out coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check-types": "tsc --noEmit --pretty",
    "test": "vitest run --pool forks",
    "test:e2e": "cross-env E2E_MOCK_AUTH=true NEXT_PUBLIC_E2E_MOCK_AUTH=true playwright test",
    "e2e:seed": "dotenv -e .env -- tsx scripts/e2e-seed.ts",
    "e2e:seed:onboarding": "dotenv -e .env -- tsx scripts/e2e-seed-onboarding.ts",
    "e2e:reset": "dotenv -e .env -- tsx scripts/e2e-reset.ts",
    "commit": "cz",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -c production -- drizzle-kit migrate",
    "db:seed": "dotenv -c production -- tsx scripts/db-seed.ts",
    "db:studio": "dotenv -c production -- drizzle-kit studio",
    "prepare": "husky"
  },
  "dependencies": {
    "@clerk/localizations": "^4.7.0",
    "@clerk/mcp-tools": "^0.6.0",
    "@clerk/nextjs": "^7.4.2",
    "@clerk/themes": "^2.4.57",
    "@electric-sql/pglite": "^0.4.6",
    "@hookform/resolvers": "^5.4.0",
    "@logtail/pino": "^0.5.8",
    "@modelcontextprotocol/server": "^2.0.0",
    "@next/third-parties": "16.2.6",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/nextjs": "^10.55.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.16.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron": "^4.4.0",
    "date-fns": "^4.3.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.17.0",
    "luxon": "^3.7.2",
    "mcp-handler": "^2.1.1",
    "next": "16.2.6",
    "next-intl": "^4.13.0",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.76.1",
    "recharts": "^3.8.1",
    "sharp": "^0.34.5",
    "stripe": "^22.2.0",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@clerk/testing": "^2.0.34",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@commitlint/cz-commitlint": "^21.0.2",
    "@eslint-react/eslint-plugin": "^5.8.6",
    "@faker-js/faker": "^10.4.0",
    "@next/bundle-analyzer": "^16.2.6",
    "@next/eslint-plugin-next": "^16.2.6",
    "@percy/cli": "^1.31.14",
    "@percy/playwright": "^1.1.0",
    "@playwright/test": "^1.60.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cron": "^2.4.3",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.15",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/expect": "^4.1.7",
    "checkly": "^8.4.0",
    "commitizen": "^4.3.1",
    "cross-env": "^10.1.0",
    "cssnano": "^8.0.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.10.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-testing-library": "^7.16.2",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.15",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.3",
    "start-server-and-test": "^3.0.5",
    "tailwindcss": "^4.3.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.7",
    "vitest-fail-on-console": "^0.10.1"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      "@semantic-release/git",
      "@semantic-release/github"
    ]
  },
  "overrides": {
    "@types/react": "19.2.15"
  }
}
