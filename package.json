{
  "name": "migraine-club",
  "version": "1.8.0",
  "private": true,
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=26.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "cross-env SPA_DIST=apps/client/dist apps/server/bin/server",
    "lint": "turbo run lint lint:root",
    "lint:fix": "eslint . --fix",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "gen": "turbo run gen",
    "clean": "turbo run clean",
    "db:generate": "npm run generate -w @migraine/db",
    "db:migrate": "npm run migrate -w @migraine/db",
    "db:seed": "npm run seed -w @migraine/db",
    "db:studio": "npm run studio -w @migraine/db",
    "commit": "cz",
    "prepare": "husky",
    "lint:root": "eslint --no-warn-ignored *.ts *.mjs *.js turbo.json render.yaml .github"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/cz-commitlint": "^21.2.4",
    "@eslint-react/eslint-plugin": "^5.30.5",
    "@next/eslint-plugin-next": "^16.4.6",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^26.6.6",
    "commitizen": "^4.3.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-jest-dom": "^5.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-react-refresh": "^0.5.8",
    "eslint-plugin-testing-library": "^7.16.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "semantic-release": "^26.0.1",
    "turbo": "^2.11.13",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      [
        "@semantic-release/git",
        {
          "message": "chore(release): ${nextRelease.version} [skip ci] [skip render]\n\n${nextRelease.notes}"
        }
      ],
      "@semantic-release/github"
    ]
  },
  "overrides": {
    "@types/react": "19.3.0"
  }
}
