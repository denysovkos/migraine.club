{
  "name": "migraine-club",
  "version": "1.6.1",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "dev:server": "dotenv -c -- go run ./cmd/server",
    "build": "npm run build:spa && make build",
    "build:spa": "vite build --config web/vite.config.ts && tsx web/scripts/prerender.mts",
    "start": "cross-env SPA_DIST=web/dist ./bin/server",
    "clean": "rimraf web/dist bin coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check-types": "tsc --noEmit --pretty",
    "test": "vitest run --pool forks",
    "test:e2e": "cross-env E2E_MOCK_AUTH=true NEXT_PUBLIC_E2E_MOCK_AUTH=true playwright test",
    "e2e:seed": "dotenv -e .env -- tsx scripts/e2e-seed.ts",
    "e2e:seed:onboarding": "dotenv -e .env -- tsx scripts/e2e-seed-onboarding.ts",
    "e2e:seed:attack-mode": "dotenv -e .env -- tsx scripts/e2e-seed-attack-mode.ts",
    "e2e:seed:pain-timeline": "dotenv -e .env -- tsx scripts/e2e-seed-pain-timeline.ts",
    "e2e:seed:relief": "dotenv -e .env -- tsx scripts/e2e-seed-relief.ts",
    "e2e:reset": "dotenv -e .env -- tsx scripts/e2e-reset.ts",
    "commit": "cz",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -c production -- drizzle-kit migrate",
    "db:seed": "dotenv -c production -- tsx scripts/db-seed.ts",
    "db:studio": "dotenv -c production -- drizzle-kit studio",
    "prepare": "husky"
  },
  "dependencies": {
    "@clerk/localizations": "^4.24.8",
    "@clerk/nextjs": "^7.10.0",
    "@clerk/react": "6.18.8",
    "@hookform/resolvers": "^7.0.6",
    "@next/third-parties": "16.4.6",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-pdf/renderer": "^4.9.0",
    "@sentry/react": "^11.12.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.73.0",
    "luxon": "^3.7.2",
    "next": "16.4.6",
    "next-intl": "^4.15.1",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "react-router": "^8.5.2",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "use-intl": "^4.15.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/cz-commitlint": "^21.2.4",
    "@eslint-react/eslint-plugin": "^5.30.3",
    "@next/eslint-plugin-next": "^16.4.6",
    "@playwright/test": "^1.65.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "commitizen": "^4.3.2",
    "cross-env": "^10.1.0",
    "cssnano": "^9.9.0",
    "dotenv-cli": "^11.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-jest-dom": "^5.10.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-react-refresh": "^0.5.8",
    "eslint-plugin-testing-library": "^7.16.2",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.1",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.33",
    "rimraf": "^6.1.4",
    "semantic-release": "^26.0.1",
    "tailwindcss": "^4.3.5",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.8",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0",
    "vitest-fail-on-console": "^0.10.1"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      "@semantic-release/git",
      "@semantic-release/github"
    ]
  },
  "overrides": {
    "@types/react": "19.3.0"
  }
}
